# Server only. Never expose these values to Vite variables.
TIKHUB_API_KEY=
TIKHUB_BASE_URL=https://api.tikhub.dev

APIMART_API_KEY=
APIMART_BASE_URL=https://api.apimart.ai

# Paid media generation stays behind the desktop quote-and-confirm gate.
# These values never expose the API key to the renderer.
MEDIA_GENERATION_PROVIDER=apimart
MEDIA_GENERATION_MODEL=kling-v3

# Optional desktop AI edit proposer. Leave local-fallback for offline work.
AI_EDIT_PROVIDER=local-fallback
# ai-sdk uses the official Vercel AI SDK 7 + OpenAI-compatible adapter;
# mastra uses Mastra 1.58 as an orchestration adapter over the same model;
# http uses the legacy normalized chat adapter for comparison.
AI_EDIT_ADAPTER=ai-sdk
AI_EDIT_MODEL=gpt-5-nano
# Script proposal default is gpt-4.1-mini; override only after a bounded structured-output smoke.
AI_SCRIPT_MODEL=gpt-4.1-mini

# Any OpenAI-compatible chat completion endpoint.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=gpt-5-mini

CREATOR_COPILOT_PORT=4317
