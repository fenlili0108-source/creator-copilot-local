{
  "name": "creator-copilot-local",
  "private": true,
  "version": "0.1.0",
  "description": "Local-first content creation copilot desktop app",
  "author": "Creator Copilot Contributors",
  "packageManager": "pnpm@10.33.0",
  "type": "module",
  "main": "apps/desktop/main.cjs",
  "scripts": {
    "dev": "concurrently -k -n api,web -c yellow,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:web": "vite --host 127.0.0.1 --port 4316",
    "dev:server": "tsx watch server/index.ts",
    "build": "tsc -b && tsc -p tsconfig.desktop.runtime.json && vite build",
    "build:desktop": "npm run build",
    "package:desktop": "npm run build && node scripts/package-desktop.mjs",
    "test:desktop:package": "npm run package:desktop && node scripts/desktop-package-smoke.mjs",
    "test:desktop:ui": "npm run package:desktop && node scripts/desktop-ui-smoke.mjs",
    "test:desktop:settings": "npm run package:desktop && node scripts/settings-desktop-smoke.mjs",
    "test:media:import:job": "npm run package:desktop && node scripts/media-import-job-smoke.mjs",
    "start:desktop": "node --env-file-if-exists=.env ./node_modules/electron/cli.js . --load-dist",
    "dev:desktop": "concurrently -k -n web,electron -c cyan,yellow \"npm:dev:web\" \"wait-on http://127.0.0.1:4316 && node --env-file-if-exists=.env ./node_modules/electron/cli.js .\"",
    "start": "tsx server/index.ts",
    "test": "vitest run",
    "test:render:smoke": "npm run build && node scripts/render-smoke.mjs",
    "test:render:layered": "npm run build && node scripts/layered-render-smoke.mjs",
    "test:creation:edit:e2e": "npm run build && node scripts/creation-edit-e2e.mjs",
    "test:render:recovery": "npm run build && node scripts/render-recovery-smoke.mjs",
    "test:analysis:sidecar": "node scripts/analysis-sidecar-smoke.mjs",
    "test:analysis:recovery": "npm run build && node scripts/analysis-recovery-smoke.mjs",
    "test:analysis:quality": "npm run build && node scripts/analysis-quality-smoke.mjs",
    "test:analysis:quality:local": "npm run build && node scripts/analysis-quality-local-smoke.mjs",
    "test:analysis:quality:calibration": "npm run build && node scripts/analysis-quality-calibration.mjs",
    "test:providers:live": "node --env-file=.env scripts/provider-smoke.mjs",
    "test:account-research:live": "npm run build && node --env-file=.env scripts/account-research-smoke.mjs",
    "test:topic-radar:live": "npm run build && node --env-file=.env scripts/topic-radar-smoke.mjs",
    "test:topic:library": "npm run build && node scripts/topic-library-smoke.mjs",
    "test:agent:live": "npm run build && node --env-file=.env scripts/agent-proposal-smoke.mjs",
    "test:script:live": "npm run build && node --env-file=.env scripts/script-proposal-smoke.mjs",
    "typecheck": "tsc -b --pretty false"
  },
  "dependencies": {
    "@ai-sdk/openai-compatible": "^3.0.30",
    "@mastra/core": "1.58.0",
    "ai": "^7.0.65",
    "better-sqlite3": "^12.4.1",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "lucide-react": "^0.468.0",
    "multer": "^2.0.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "electron": "^43.0.0",
    "tsx": "^4.20.5",
    "typescript": "~5.8.3",
    "vite": "^7.1.3",
    "vitest": "^3.2.4",
    "wait-on": "^8.0.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "local.creator.copilot",
    "productName": "Creator Copilot Local",
    "directories": { "output": "release" },
    "asar": true,
    "asarUnpack": ["node_modules/better-sqlite3/**/*", "electron/**/*", "apps/desktop/analysis-worker.cjs", "apps/desktop/sidecars/**/*"],
    "files": ["dist/**/*", "dist-electron/**/*", "electron/**/*", "apps/desktop/**/*", "package.json"],
    "mac": { "target": [{ "target": "dir", "arch": ["arm64"] }], "category": "public.app-category.video" },
    "win": { "target": [{ "target": "dir", "arch": ["x64"] }] },
    "linux": { "target": [{ "target": "dir", "arch": ["x64"] }] }
  }
}
